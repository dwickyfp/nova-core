# nova-core local development configuration.
# Copy to config.toml and replace placeholder credentials before use.

[server]
host = "127.0.0.1"
port = 3306

[storage]
s3_endpoint = "http://localhost:9000"
s3_bucket = "nova"
s3_access_key = "<minio-access-key>"
s3_secret_key = "<minio-secret-key>"
s3_region = "us-east-1"

[metadata]
fdb_cluster_file = "docker:docker@127.0.0.1:4500"

[auth]
enabled = false
allow_insecure = true
default_username = "root"
default_password_hash = ""
